<div style="display: flex; gap: 10px;">
  <%= button_tag "Select All", type: "button", id: "select-all-btn", class: "btn btn-outline-primary" %>
  <%= button_to "Retry", "", method: :post, class: "btn btn-outline-primary" %>
</div>
<br/>
<ol class="list-group">
  <li class="list-group-item d-flex justify-content-between align-items-start">
    <div class="ms-2 me-auto">
      <div class="fw-bold">
        <input type="checkbox" class="selectable-checkbox" id="subheading-checkbox" style="margin-right: 10px;">
        Error 404
      </div>
    </div>
    <span class="badge text-bg-primary rounded-pill">14</span>
  </li>
  <li class="list-group-item d-flex justify-content-between align-items-start">
    <div class="ms-2 me-auto">
      <div class="fw-bold"><input type="checkbox" class="selectable-checkbox" id="subheading-checkbox" style="margin-right: 10px;"> Timeout</div>
    </div>
    <span class="badge text-bg-primary rounded-pill">14</span>
  </li>
  <li class="list-group-item d-flex justify-content-between align-items-start">
    <div class="ms-2 me-auto">
      <div class="fw-bold"><input type="checkbox" class="selectable-checkbox" id="subheading-checkbox" style="margin-right: 10px;"> Rate Limited</div>
    </div>
    <span class="badge text-bg-primary rounded-pill">14</span>
  </li>
</ol>
<%# Javascript logic, can be moved to some other javascript file. %>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const selectAllButton = document.getElementById("select-all-btn");
    const checkboxes = document.querySelectorAll(".selectable-checkbox");

    selectAllButton.addEventListener("click", () => {
      const allCheckBoxCheck = Array.from(checkboxes).every(checkbox => checkbox.checked);

      checkboxes.forEach(checkbox => {
      checkbox.checked = !allCheckBoxCheck;
    });
    });
  });
</script>